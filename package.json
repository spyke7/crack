{
  "name": "crack",
  "version": "1.0.0",
  "description": "Multiplayer colony-war sandbox: design your colony's stats, drop a seed, watch territory patterns emerge.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "build": "esbuild src/auth-client.js --bundle --format=esm --outfile=public/vendor/auth.js",
    "start": "npm run build && node server.js",
    "dev": "npm run build && node --watch server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "node test.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "dotenv": "^18.0.6",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2"
  }
}
